# Refund Bot Configuration
# Copy this file to .env and fill in your values

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/refund_bot.db

# External Services (Docker internal URLs)
ORDERS_SERVICE_URL=http://mock-orders:8001
PAYMENTS_SERVICE_URL=http://mock-payments:8002

# LLM Configuration
# For local Ollama:
LLM_API_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=
LLM_MODEL=llama2

# Routing - configure multiple endpoints (JSON string)
# Strategies: single, fallback, cost, latency, load
LLM_ROUTER_STRATEGY=fallback
# Complexity thresholds to route to cloud for long/complex requests
LLM_COMPLEXITY_THRESHOLD=40
LLM_COMPLEXITY_CHAR_THRESHOLD=800
LLM_REQUEST_TIMEOUT_SECONDS=20
# Example with local + OpenAI cloud endpoints. Keep the JSON on one line.
# LLM_ENDPOINTS_JSON='[{"name":"local","url":"http://ollama:11434/v1","api_key":"","model":"llama3.2:1b","priority":1,"is_local":true},{"name":"cloud","url":"https://api.openai.com/v1","api_key":"sk-your-api-key","model":"gpt-4o-mini","priority":2,"is_local":false,"cost_per_1k_tokens":0.15}]'

# For OpenAI:
# LLM_API_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-your-api-key
# LLM_MODEL=gpt-3.5-turbo

# Refund Policy
REFUND_WINDOW_DAYS=30
MAX_REFUND_AMOUNT=1000.0

# Logging
LOG_LEVEL=INFO
